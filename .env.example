# Copy this file to .env and fill in the real values (never commit .env)
PG_HOST=your-neon-host.neon.tech
PG_PORT=5432
PG_DB=neondb
PG_SSLMODE=require
PG_ADMIN_USER=neondb_owner
PG_ADMIN_PASSWORD='your-neon-password'
PG_READONLY_USER=hr_readonly
PG_READONLY_PASSWORD='your-readonly-password'
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD='your-neo4j-password'
GROQ_API_KEY='your-groq-key'
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
